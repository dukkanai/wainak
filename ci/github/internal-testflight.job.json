{
  "name": "Manual internal TestFlight — protected environment required",
  "if": "github.event_name == 'workflow_dispatch' && inputs.target == 'mac-internal' && github.repository == 'dukkanai/wainak' && github.event.repository.private == false && github.ref == 'refs/heads/dev/ios-testflight-internal-20261029' && inputs.expected_sha == github.sha && github.run_attempt == 1",
  "runs-on": "macos-26",
  "timeout-minutes": 45,
  "permissions": {
    "contents": "read"
  },
  "environment": "wainek-internal-testflight",
  "concurrency": {
    "group": "wainek-internal-testflight",
    "cancel-in-progress": false
  },
  "env": {
    "WAINEK_REPOSITORY_VISIBILITY": "${{ github.event.repository.visibility }}",
    "WAINEK_RUNNER_LABEL": "macos-26",
    "WAINEK_EXPECTED_SHA": "${{ inputs.expected_sha }}",
    "WAINEK_BUILD_NUMBER": "${{ inputs.build_number }}",
    "WAINEK_SIGNED_TARGET": "mac-internal",
    "WAINEK_SIGNED_ENVIRONMENT": "wainek-internal-testflight"
  },
  "steps": [
    {
      "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
      "with": {
        "persist-credentials": false,
        "ref": "${{ github.sha }}"
      }
    },
    {
      "uses": "actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0",
      "with": {
        "python-version": "3.12.7"
      }
    },
    {
      "name": "Check inactive or reviewed configuration",
      "run": "python3 ci/github/internal_testflight.py --check"
    },
    {
      "name": "Verify source, SDK, compile and sign internal UI",
      "env": {
        "WAINEK_DISTRIBUTION_P12_B64": "${{ secrets.WAINEK_DISTRIBUTION_P12_B64 }}",
        "WAINEK_DISTRIBUTION_P12_PASSWORD": "${{ secrets.WAINEK_DISTRIBUTION_P12_PASSWORD }}",
        "WAINEK_APP_STORE_PROFILE_B64": "${{ secrets.WAINEK_APP_STORE_PROFILE_B64 }}"
      },
      "run": "python3 ci/github/internal_testflight.py --build"
    },
    {
      "name": "Upload verified internal-only IPA to Apple",
      "env": {
        "WAINEK_ASC_PRIVATE_KEY_B64": "${{ secrets.WAINEK_ASC_PRIVATE_KEY_B64 }}"
      },
      "run": "python3 ci/github/internal_testflight.py --upload"
    },
    {
      "name": "Remove owned signing material",
      "if": "${{ always() }}",
      "run": "python3 ci/github/internal_testflight.py --cleanup"
    }
  ]
}
